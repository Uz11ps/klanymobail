# Root ignores (monorepo)
.DS_Store

# Env files (keep templates only)
.env
**/.env
!.env.example
/.env.deploy
/.env.deploy.*
!.env.deploy.example

# Flutter / Dart artifacts (root-level safety; apps have their own .gitignore too)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/.metadata
**/coverage/

# IDE
.idea/
**/*.iml
.vscode/

# Node / backend artifacts
**/node_modules/
**/dist/
**/.npm/
**/.pnpm-store/

# Firebase secrets (NEVER commit service account keys)
**/*firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json

# built admin web for deploy
infra/nginx/admin_web/

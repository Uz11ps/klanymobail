PORT=3000

# Docker Compose default
DATABASE_URL=postgresql://klany:change_me@localhost:5434/klany

JWT_SECRET=dev_secret_change_me

# Flutter Web / браузер: пусто = любой Origin отражается; иначе список через запятую.
# CORS_ORIGIN_ALLOWLIST=https://klanymobail.ru
# CORS_CREDENTIALS=true

# MinIO/S3 для presigned URL (upload аватарки, доказательства квестов, товары).
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# Docker Compose: если на хосте занят :9000, в корневом `.env` на сервере задай MINIO_HOST_PORT=9002 (MINIO_PORT для api внутри compose всегда 9000).
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio123
# По умолчанию имена физических бакетов = логические (member-avatars, quest-evidence, shop-products).
# MINIO_BUCKET_MEMBER_AVATARS=member-avatars
# MINIO_BUCKET_QUEST_EVIDENCE=quest-evidence
# MINIO_BUCKET_SHOP_PRODUCTS=shop-products

# Публичный URL nginx для скачивания по presigned GET (не http://minio:9000 для телефона).
# MINIO_PUBLIC_BASE_URL=http://localhost:8782

